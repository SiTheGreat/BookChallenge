	// Stock Limit Triggers //////////////////////////////////////////////////////////
	// Set flags based on how many books the player has read

	{
		"Action": "EditData",
		"Target": "Data/TriggerActions",
		"Entries": {
			// Unlock books
			"{{ModId}}_UnlockedBooksToRead": {
				"Id": "{{ModId}}_UnlockedBooksToRead",
				"MarkActionApplied": true,
				"Trigger": "DayEnding",
				"Condition": "PLAYER_HAS_MAIL ALL HasMagnifyingGlass", // Conditions to unlock books.
				"Actions": [
					"AddMail All {{ModId}}_UnlockedBooks",
				]
			},
			// Set stock limits based on number of books read
			"{{ModId}}_StockLimit0": {
				"Id": "{{ModId}}_StockLimit0",
				"MarkActionApplied": true,
				"Trigger": "DayEnding",
				"Condition": "PLAYER_STAT Current bc_hasbooks 10",
				"Actions": [
					"AddMail All {{ModId}}_BookStock0",
				]
			},
			"{{ModId}}_StockLimit1": {
				"Id": "{{ModId}}_StockLimit1",
				"MarkActionApplied": true,
				"Trigger": "DayEnding",
				"Condition": "PLAYER_STAT Current bc_hasbooks 35",
				"Actions": [
					"AddMail All {{ModId}}_BookStock1",
				]
			},
			"{{ModId}}_StockLimit2": {
				"Id": "{{ModId}}_StockLimit2",
				"MarkActionApplied": true,
				"Trigger": "DayEnding",
				"Condition": "PLAYER_STAT Current bc_hasbooks 60",
				"Actions": [
					"AddMail All {{ModId}}_BookStock2",
				]
			},
			// BC Achievement Counter
			"{{ModId}}_AchievementCounter": {
				"Id": "{{ModId}}_AchievementCounter",
				"MarkActionApplied": true,
				"Trigger": "DayEnding",
				"Condition": "PLAYER_HAS_MAIL ALL {{ModId}}_UnlockedBooks",
				"Actions": [
					"IncrementStat bc_achievement 70", // Add total number of books this mod adds to the achievement counter, for eventual use in an achievement.
				]
			},
		},
	},

	// Includes //////////////////////////////////////////////////////////

	{
		// Book items
		"Action": "Include",
		"FromFile": "Data/Objects.json",
		"When": {
			"HasFlag: |contains={{ModId}}_UnlockedBooks": true,
		},
	},

	{
		// Turns books into secret notes
		"Action": "Include",
		"FromFile": "Data/SecretNotes.json",
		"When": {
			"HasFlag: |contains={{ModId}}_UnlockedBooks": true,
		},
	},

